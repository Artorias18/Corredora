/* === THEME GLOBAL PARA CORREDORA === */

QWidget {
    background-color: #1e1e1e;
    color: #f5f5f5;
    font-family: "Segoe UI";
    font-size: 14px;
}

/* === QLineEdit (inputs) === */
QLineEdit {
    background-color: #2c2c2c;
    border: 1px solid #3c3c3c;
    border-radius: 6px;
    padding: 6px;
    selection-background-color: #005fa3;
}
QLineEdit:focus {
    border: 1px solid #0078d7;
}

/* === QPushButton === */
QPushButton {
    background-color: #005fa3;
    border: none;
    border-radius: 6px;
    padding: 8px;
    color: white;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #0078d7;
}
QPushButton:pressed {
    background-color: #00457a;
}

/* === QLabel === */
QLabel {
    color: #f5f5f5;
}

/* === QTabWidget (pestañas del panel principal) === */
QTabWidget::pane {
    border: 1px solid #3c3c3c;
    background: #2c2c2c;
}
QTabBar::tab {
    background: #2c2c2c;
    color: #f5f5f5;
    padding: 8px 20px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QTabBar::tab:selected {
    background: #005fa3;
    font-weight: bold;
}
QTabBar::tab:hover {
    background: #0078d7;
}

/* === Mensajes o etiquetas especiales === */
QLabel#success {
    color: #3fb950;
}
QLabel#error {
    color: #d73a49;
}
